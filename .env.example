POSTGRES_USER=gemmq
POSTGRES_PASSWORD=<long random string>
POSTGRES_DB=gemmq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

API_KEY=<secure_api_key>
# uvicorn processes in the API container. make up API_PROCESSES=... overrides it.
API_PROCESSES=1

RABBITMQ_USER=gemmq
RABBITMQ_PASSWORD=<long random string>
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# hip = real GPU kernels, fake = NumPy stand-in (no GPU needed). make up RUNNER=... overrides it.
WORKER_RUNNER=hip
# timed kernel runs per task (after one warm-up), averaged into ms
KERNEL_ITERS=2

# Pushgateway for worker/sweeper metrics when they run on the host (compose sets its own)
PUSHGATEWAY_URL=localhost:9091
