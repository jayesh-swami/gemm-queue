    {
      "type": "row",
      "title": "Reliability",
      "id": 12,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Dead-letter queues",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_detailed_queue_messages{vhost=\"/\", queue=~\".*dlq\"}",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Messages parked after failing. Should stay at 0."
    },
    {
      "type": "stat",
      "title": "Task publish failures (1h)",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 27,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(api_task_publish_failures_total[1h])",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Jobs saved whose tasks failed to publish; the sweeper re-publishes them."
    },
    {
      "type": "stat",
      "title": "Seconds since last sweep",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - sweeper_last_success_timestamp_seconds",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "The sweeper runs every 60 s; much more than that means it's down."
    },
    {
      "type": "stat",
      "title": "Seconds since worker push",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 27,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - push_time_seconds{job=\"worker\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Each worker pushes every 5 s; a growing number means that worker is gone."
    },
    {
      "type": "timeseries",
      "title": "Sweeper actions (per 10 min)",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(sweeper_republished_total[10m])",
          "legendFormat": "re-published",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "increase(sweeper_failed_total[10m])",
          "legendFormat": "failed",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
